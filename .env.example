# Copie para .env e ajuste. O arquivo .env NÃO deve ser versionado.
# cp .env.example .env

# --- Banco de dados ---
POSTGRES_DB=techjobs
POSTGRES_USER=techjobs
# Obrigatório: gere um valor forte, por exemplo `openssl rand -base64 24`
POSTGRES_PASSWORD=troque-por-um-valor-forte
POSTGRES_PORT=5432

# --- Portas expostas ---
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- Backend ---
CORS_ALLOWED_ORIGINS=http://localhost:8081
LOG_LEVEL=INFO
SCRAPERS_ENABLED=true
SCHEDULER_ENABLED=true
# Varredura profunda (enche a base com milhares de vagas). Desligue para consumir menos rede.
HARVEST_ENABLED=true
# Identifique-se para os sites de origem: e-mail de contato ajuda em caso de problema.
SCRAPER_USER_AGENT=TechJobsFinder/0.1 (+https://github.com/seu-usuario/techjobs-finder; seu-email@exemplo.com)

# --- Cache (Redis) ---
# Host vazio desliga o Redis: a aplicação passa a usar cache em memória e continua
# funcionando, só sem compartilhar entre instâncias nem sobreviver a reinício.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=256mb

# --- Frontend ---
# Vazio usa o proxy /api do nginx. Preencha apenas se o backend estiver em outro host.
# Atenção: o Vite embute este valor no bundle em tempo de build.
VITE_API_URL=

# Limite do currículo enviado pelo usuário.
RESUME_MAX_FILE_SIZE=5MB
# Prazo de guarda do currículo (dado pessoal). A limpeza diária apaga o que passar disso,
# junto com o usuário que ficar sem nenhum currículo.
RESUME_RETENTION=180d

# --- Criptografia do currículo ---
# Obrigatória: sem ela a aplicação não sobe. Gere com `openssl rand -base64 32`.
# O currículo é gravado cifrado (AES-256-GCM) e um dump do banco não o revela.
RESUME_ENCRYPTION_KEY_V1=troque-por-32-bytes-em-base64
# Para rotacionar: acrescente RESUME_ENCRYPTION_KEY_V2, aponte a ativa para v2 e mantenha
# a v1 configurada até a recifragem terminar.
RESUME_ENCRYPTION_ACTIVE_KEY=v1

# --- Autenticação ---
# Em produção (HTTPS) mantenha true: o cookie de sessão só trafega em conexão segura.
AUTH_COOKIE_SECURE=true
# Prazo máximo da sessão e prazo de inatividade.
AUTH_SESSION_TIMEOUT=30d
AUTH_SESSION_IDLE=7d

# --- Limite de envios (upload de currículo) ---
RATE_LIMIT_ENABLED=true
# Envios seguidos tolerados por cliente e tempo para repor o balde inteiro.
RESUME_UPLOAD_BURST=5
RESUME_UPLOAD_PERIOD=10m
